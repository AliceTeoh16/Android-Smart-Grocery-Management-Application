<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <provider android:name="com.xmum.smartgrocery.ui.main.SpeechScriptProvider"
            android:authorities="com.xmum.smartgrocery.test.speech"
            android:exported="true" android:process=":scripted_speech" />
        <service android:name="com.xmum.smartgrocery.ui.main.ScriptedRecognitionService"
            android:exported="true" android:process=":scripted_speech"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
    </application>
</manifest>
