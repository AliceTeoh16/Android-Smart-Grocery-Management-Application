<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="5dp">

    <View
        android:id="@+id/view_ingredient_bullet"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_status_dot_sage" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_history_ingredient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Chicken 500g" />

        <TextView
            android:id="@+id/text_history_ingredient_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Added to Shopping List"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_history_ingredient_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_soft_panel"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/primary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="In Stock" />
</LinearLayout>
