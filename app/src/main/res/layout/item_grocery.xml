<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="20dp" app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="196dp" android:padding="12dp" android:orientation="vertical">
        <View android:id="@+id/view_category_indicator" android:layout_width="32dp" android:layout_height="4dp" android:layout_marginBottom="10dp" android:background="#315B40" />
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp">
            <TextView android:id="@+id/text_item_name" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginEnd="4dp" android:maxLines="2" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="#24372B"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/button_edit_item" app:layout_constraintTop_toTopOf="parent" />
            <ImageButton android:id="@+id/button_edit_item" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit_24" android:contentDescription="Edit item" app:tint="#315B40"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView android:id="@+id/text_category_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="28dp" android:layout_marginTop="6dp"
            android:maxWidth="160dp" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:paddingHorizontal="10dp"
            android:textSize="10sp" android:textStyle="bold" android:textColor="#315B40" android:background="@drawable/pantry_inventory_quantity_bg" />
        <TextView android:id="@+id/text_item_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:maxLines="1" android:ellipsize="end" android:textColor="#315B40" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Qty" android:textColor="#738075" android:textSize="10sp" />
            <LinearLayout android:id="@+id/layout_quantity_controls" android:layout_width="wrap_content" android:layout_height="40dp"
                android:background="@drawable/pantry_inventory_quantity_bg" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="4dp">
                <ImageButton android:id="@+id/button_decrement" android:layout_width="30dp" android:layout_height="32dp" android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_minus_24" android:contentDescription="Decrease quantity" app:tint="#315B40" />
                <TextView android:id="@+id/text_quantity" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center"
                    android:textColor="#315B40" android:textSize="14sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/button_increment" android:layout_width="30dp" android:layout_height="32dp" android:padding="7dp"
                    android:background="@drawable/pantry_inventory_increment_bg" android:src="@drawable/ic_plus_24" android:contentDescription="Increase quantity" app:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/text_expiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="10sp" android:textColor="#738075" />
        <TextView android:id="@+id/text_shared_change" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="10sp" android:textColor="#738075"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        <LinearLayout android:id="@+id/layout_expired_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/button_toss" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:minWidth="0dp" android:minHeight="0dp"
                android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="Toss" android:textAllCaps="false" android:textSize="10sp" android:textColor="#AD3327"
                app:cornerRadius="10dp" app:backgroundTint="#FAEBDD" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_update_expiry" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minWidth="0dp" android:minHeight="0dp"
                android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="4dp" android:text="Update" android:textAllCaps="false" android:textSize="10sp" android:textColor="#315B40"
                app:cornerRadius="10dp" app:backgroundTint="#E6EFDE" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
