<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="24dp"
        android:paddingEnd="24dp" android:paddingBottom="100dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/pantry_share_icon_bg">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:importantForAccessibility="no"
                    android:src="@drawable/pantry_share_qr" app:tint="#315B40" />
            </FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:text="Sharing link / QR" android:textColor="#24372B"
                android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="20dp"
            android:text="Share your shopping list with a QR code or link."
            android:textColor="#738075" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/pantry_recipe_section_bg" android:padding="16dp">
            <ImageView android:id="@+id/image_shopping_share_qr"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="220dp" android:maxHeight="220dp"
                android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:contentDescription="Shopping list sharing QR code" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp"
            android:text="Sharing link" android:textColor="#315B40"
            android:textSize="13sp" android:textStyle="bold" />

        <TextView android:id="@+id/text_shopping_share_link"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/pantry_deduction_item_bg"
            android:padding="14dp" android:textColor="#315B40"
            android:textSize="12sp" android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_copy_shopping_link"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="54dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:fontFamily="sans-serif-medium" android:paddingVertical="14dp"
            android:text="Copy Link" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="15sp"
            app:backgroundTint="#C85A32" app:cornerRadius="14dp"
            app:icon="@drawable/pantry_share_copy" app:iconGravity="textStart"
            app:iconPadding="10dp" app:iconSize="20dp" app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_close_shopping_link"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:minHeight="54dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:fontFamily="sans-serif-medium" android:paddingVertical="14dp"
            android:text="Close" android:textAllCaps="false"
            android:textColor="#315B40" android:textSize="15sp"
            app:backgroundTint="#E6EFDE" app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
