<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="0dp" app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingVertical="8dp">
        <CheckBox android:id="@+id/checkbox_purchased" android:layout_width="32dp" android:layout_height="40dp"
            android:button="@drawable/pantry_checkbox" app:buttonCompat="@drawable/pantry_checkbox" android:buttonTint="@null" app:buttonTint="@null" app:buttonIcon="@null" app:useMaterialThemeColors="false" android:contentDescription="Mark purchased"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/text_item_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#24372B" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/checkbox_purchased" app:layout_constraintEnd_toStartOf="@id/text_estimated_cost" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/text_estimated_cost" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#315B40" android:textSize="12sp" android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout android:id="@+id/shopping_item_detail" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" app:layout_constraintStart_toStartOf="@id/text_item_name" app:layout_constraintEnd_toStartOf="@id/button_delete" app:layout_constraintTop_toBottomOf="@id/text_item_name">
            <TextView android:id="@+id/text_quantity_needed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="90dp" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#738075" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" · " android:textColor="#738075" android:textSize="10sp" />
            <TextView android:id="@+id/text_member" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#738075" />
            <Button android:id="@+id/button_assign" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="24dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp"
                android:insetTop="0dp" android:insetBottom="0dp" android:text="Assign…" android:textAllCaps="false" android:textColor="#315B40" android:textSize="10sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/button_delete" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"
            android:src="@drawable/ic_delete_24" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Remove from shopping list" app:tint="#738075"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/text_estimated_cost" />
        <TextView android:id="@+id/text_category" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="10sp" android:paddingHorizontal="8dp" android:paddingVertical="5dp"
            app:layout_constraintStart_toStartOf="@id/text_item_name" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shopping_item_detail" />
        <TextView android:id="@+id/text_added_by" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone"
            android:textSize="10sp" android:textColor="#738075" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/text_item_name" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/text_category" />
        <View android:layout_width="0dp" android:layout_height="0.5dp" android:background="#DEE4D8"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/text_added_by" android:layout_marginTop="6dp" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
