<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/pantry_recipe_sheet_bg" android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="12dp"
        android:paddingEnd="24dp" android:paddingBottom="100dp">

        <View android:layout_width="42dp" android:layout_height="4dp"
            android:layout_gravity="center_horizontal" android:background="@drawable/pantry_deduction_handle_bg" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/pantry_share_icon_bg">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:layout_gravity="center" android:importantForAccessibility="no"
                    android:src="@drawable/ic_group_24" app:tint="#315B40" />
            </FrameLayout>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:text="Household Invitation" android:textColor="#24372B"
                android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="20dp"
            android:text="Scan the QR code or use the code/link fallback to join Home Pantry."
            android:textColor="#738075" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/pantry_recipe_section_bg" android:padding="16dp">
            <ImageView android:id="@+id/image_household_invite_qr"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="180dp" android:maxHeight="180dp"
                android:adjustViewBounds="true" android:scaleType="fitCenter"
                android:contentDescription="Household invitation QR code" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Scan to join"
                android:textColor="#738075" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="16dp"
            android:background="@drawable/pantry_deduction_summary_bg"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Household code" android:textColor="#738075" android:textSize="12sp" />
                <TextView android:id="@+id/text_household_invite_code"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:letterSpacing="0.08"
                    android:textColor="#315B40" android:textSize="26sp" android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/button_copy_household_code"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:minHeight="48dp"
                android:insetTop="0dp" android:insetBottom="0dp" android:fontFamily="sans-serif-medium"
                android:text="Copy Code" android:textAllCaps="false" android:textColor="#315B40" android:textSize="12sp"
                app:backgroundTint="#F9F8F3" app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView android:id="@+id/text_household_invite_link"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/pantry_deduction_item_bg"
            android:padding="14dp" android:textColor="#315B40" android:textSize="12sp" android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/button_share_household_link"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="54dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:fontFamily="sans-serif-medium"
            android:paddingVertical="14dp" android:text="Share Link" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="15sp" app:backgroundTint="#C85A32"
            app:cornerRadius="14dp" app:icon="@drawable/ic_share_24" app:iconGravity="textStart"
            app:iconPadding="10dp" app:iconSize="20dp" app:iconTint="#FFFFFF" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:layout_marginBottom="10dp"
            android:text="Invite by email" android:textColor="#24372B" android:textSize="17sp" android:textStyle="bold" />

        <EditText android:id="@+id/edit_household_invite_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="54dp" android:background="@drawable/pantry_deduction_item_bg"
            android:backgroundTint="@null" android:padding="14dp" android:singleLine="true"
            android:hint="Member / family email" android:textColor="#24372B"
            android:textColorHint="#738075" android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/button_send_household_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="54dp"
            android:insetTop="0dp" android:insetBottom="0dp" android:fontFamily="sans-serif-medium"
            android:paddingVertical="14dp" android:text="Send Email Invite" android:textAllCaps="false"
            android:textColor="#FFFFFF" android:textSize="15sp"
            app:backgroundTint="#C85A32" app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
