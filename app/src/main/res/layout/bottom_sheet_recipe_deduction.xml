<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pantry_deduction_sheet_bg"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="100dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/pantry_deduction_handle_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif"
            android:text="Confirm ingredients used"
            android:textColor="#24372B"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_deduction_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Review quantities before updating inventory."
            android:textColor="#738075"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/pantry_deduction_summary_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_recipe_24"
                app:tint="#315B40" />

            <TextView
                android:id="@+id/text_deduction_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Your recipe"
                android:textColor="#315B40"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ingredients to use"
            android:textColor="#24372B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Adjust how much you used with the − and + controls."
            android:textColor="#738075"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layout_deduction_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm_deduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="14dp"
            android:text="Confirm ingredients used"
            android:textAllCaps="false"
            android:textColor="@color/pantry_deduction_confirm_text"
            android:textSize="15sp"
            app:backgroundTint="@color/pantry_deduction_confirm_tint"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_check_circle_24"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:iconTint="@color/pantry_deduction_confirm_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_deduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="14dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#315B40"
            android:textSize="15sp"
            app:backgroundTint="#E6EFDE"
            app:cornerRadius="14dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
