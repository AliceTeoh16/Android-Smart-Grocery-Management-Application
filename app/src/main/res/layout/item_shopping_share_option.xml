<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingBottom="10dp">
    <LinearLayout android:id="@+id/card_share_option"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="76dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp" android:duplicateParentState="true"
        android:background="@drawable/pantry_share_option_bg">
        <FrameLayout android:id="@+id/container_share_icon"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/pantry_share_icon_bg">
            <ImageView android:id="@+id/image_share_option"
                android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/text_share_option"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp" android:fontFamily="sans-serif-medium"
            android:textColor="#315B40" android:textSize="14sp" />
        <ImageView android:id="@+id/image_share_chevron"
            android:layout_width="18dp" android:layout_height="18dp"
            android:rotation="270" android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down_24" />
    </LinearLayout>
</FrameLayout>
