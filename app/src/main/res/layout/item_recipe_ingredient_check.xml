<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="14dp">

    <ImageView
        android:id="@+id/image_check_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Check status"
        android:src="@android:drawable/checkbox_on_background" />

    <TextView
        android:id="@+id/text_ingredient_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textSize="14sp"
        android:textColor="#24372B"
        tools:text="3 pcs Egg" />

    <TextView
        android:id="@+id/text_status_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pantry_recipe_status_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#315B40"
        tools:text="Owned" />
</LinearLayout>
